# Production/test-mode PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rzr_handshake

# Set these for Razorpay test mode. Leave blank with PAYMENT_PROVIDER=demo for a local link-only demo.
PAYMENT_PROVIDER=auto
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Server-side money-action safety policy (amounts are INR).
MAX_QTY=10
MAX_SPEND=100000.00
CATALOG_PAGE_SIZE=10
REVIEWS_PAGE_SIZE=5

# Client-agent settings
ACP_MCP_URL=http://127.0.0.1:8000/mcp
CUSTOMER_ID=1
CLIENT_SESSION_DB=./client-agent/session.sqlite3
